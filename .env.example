# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Browser Automation Configuration
BROWSER_HEADLESS=false
MAX_AGENT_STEPS=15
TASK_TIMEOUT_SECONDS=180
NAVIGATION_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=10000
CHROME_CDP_URL=http://127.0.0.1:9222


# Security & Network Settings
# When true, localhost/127.0.0.1 on specified test ports can be accessed for local automated testing
ALLOW_LOCAL_TEST_DOMAINS=false
TRUSTED_DOMAINS_ALLOWLIST=example.com,httpbin.org

# Logging & Artifacts
LOG_LEVEL=INFO
SCREENSHOT_DIR=task_artifacts/screenshots
